rules_version = '2';

// PortfolioIQ Firestore rules.
//
// The client filters every query by `userId`, but client-side filters are not
// access control — they only shape what the app asks for. These rules are what
// actually stops one account reading another's portfolio.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The document being written must be stamped with the caller's own uid, and
    // an update may never re-assign ownership.
    function ownsNew() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function ownsExisting() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // A user's own profile document.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /portfolios/{portfolioId} {
      allow create: if ownsNew();
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && ownsNew();
    }

    match /holdings/{holdingId} {
      allow create: if ownsNew();
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && ownsNew();
    }

    match /transactions/{transactionId} {
      allow create: if ownsNew();
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && ownsNew();
    }

    match /portfolio_history/{snapshotId} {
      allow create: if ownsNew();
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && ownsNew();
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
