{
  "expo": {
    "name": "PortfolioIQ",
    "slug": "portfolio-iq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon/ios/AppIcon~ios-marketing.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#123C38"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.portfolioiq.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon/ios/AppIcon@2x.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.portfolioiq.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "63db2884-de22-4f53-855d-09dd80ec130a"
      }
    },
    "plugins": [
      "expo-font",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "temuulenn"
        }
      ]
    ]
  }
}
