# Example Environment Variables
# Copy this file to .env and fill in your actual values.
#
# NOTE: .env is gitignored, so it is NOT uploaded to EAS cloud builds. For any
# `eas build`, set these same keys as EAS environment variables:
#   eas env:create --name FIREBASE_API_KEY --value ... --environment production
# See https://docs.expo.dev/eas/environment-variables/

# ==================== FIREBASE CONFIG ====================
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# ==================== API ENDPOINTS ====================
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com

# ==================== SERVER-SIDE SECRETS ====================
# The Groq API key is NOT an app variable — anything bundled into the app can be
# extracted from the shipped binary. It lives in Cloud Functions instead:
#   firebase functions:secrets:set GROQ_API_KEY
# Get a free key at https://console.groq.com
